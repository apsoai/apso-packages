{
  "name": "@apso/typescript-packages",
  "version": "0.0.0",
  "private": true,
  "description": "Apso first-party TypeScript libraries (npm workspace root).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @apso/crud-core -w @apso/crud-request -w @apso/crud-typeorm -w @apso/crud -w @apso/domain-events --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
