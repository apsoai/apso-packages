{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@apso/crud": [
        "../crud/src/index.ts"
      ],
      "@apso/crud-core": [
        "../crud-core/src/index.ts"
      ],
      "@apso/crud-request": [
        "../crud-request/src/index.ts"
      ],
      "@apso/crud-typeorm": [
        "../crud-typeorm/src/index.ts"
      ],
      "typeorm": [
        "node_modules/typeorm",
        "../../node_modules/typeorm"
      ],
      "@nestjs/common": [
        "node_modules/@nestjs/common",
        "../../node_modules/@nestjs/common"
      ],
      "@nestjs/core": [
        "node_modules/@nestjs/core",
        "../../node_modules/@nestjs/core"
      ],
      "@nestjs/typeorm": [
        "node_modules/@nestjs/typeorm",
        "../../node_modules/@nestjs/typeorm"
      ],
      "@nestjs/swagger": [
        "node_modules/@nestjs/swagger",
        "../../node_modules/@nestjs/swagger"
      ],
      "rxjs": [
        "node_modules/rxjs",
        "../../node_modules/rxjs"
      ],
      "@apso/postgrest-request": [
        "../postgrest-request/src/index.ts"
      ],
      "@apso/mcp": [
        "../mcp/src/index.ts"
      ],
      "@modelcontextprotocol/sdk/*": [
        "node_modules/@modelcontextprotocol/sdk/dist/cjs/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}